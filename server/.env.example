# Gemini API 키 (https://aistudio.google.com 에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델
GEMINI_MODEL=gemini-2.0-flash

# SQLite DB 파일 경로
DB_PATH=./data/edufocus.db

# Express 서버 포트
PORT=4000

# 크롤링 주기 (cron 표현식, 기본: 매일 06:00, 12:00, 18:00)
CRAWL_CRON=0 6,12,18 * * *

# 매체명 (생성되는 기사 하단 출처 표기에 사용)
MEDIA_NAME=교육포커스

# ===== edu-focus.com 발행 연동 (PUBLISH_*) =====
# API URL이 비어있으면 실제 호출 없이 페이로드만 로그로 출력합니다 (dry run).
PUBLISH_API_URL=
# 인증 헤더 이름/값 (예: Authorization / "Bearer xxxxx")
PUBLISH_AUTH_HEADER=Authorization
PUBLISH_AUTH_VALUE=
# 요청 바디 필드명 매핑 (edu-focus.com API 스펙에 맞춰 수정)
PUBLISH_FIELD_TITLE=title
PUBLISH_FIELD_BODY=content
PUBLISH_FIELD_CATEGORY=category
# 기사/칼럼 초안에 사용할 카테고리 값
PUBLISH_CATEGORY_NEWS=기사
PUBLISH_CATEGORY_COLUMN=칼럼
# 요청 바디에 항상 추가할 고정 필드 (JSON)
PUBLISH_EXTRA_FIELDS_JSON={}
# 응답 JSON에서 게시글 URL을 읽어올 경로 (점 표기, 예: data.url)
PUBLISH_RESPONSE_URL_FIELD=url
# 1이면 PUBLISH_API_URL이 설정되어 있어도 실제 호출하지 않음
PUBLISH_DRY_RUN=0
